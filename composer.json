{
    "name": "asignua/filament-xlsx-import",
    "description": "Import .xlsx, .ods and .csv into any model from a Filament 5 panel: the file's columns are mapped to attributes and related records with casts and presets, a dry run shows what will be created, updated or fail before anything is written, big files run in the queue, failed rows come back as an .xlsx report. Works with or without a Filament Importer class.",
    "keywords": ["filament", "filament-plugin", "laravel", "xlsx", "excel", "import", "csv", "ods", "openspout", "dry-run"],
    "homepage": "https://github.com/asignua/filament-xlsx-import",
    "support": {
        "issues": "https://github.com/asignua/filament-xlsx-import/issues",
        "source": "https://github.com/asignua/filament-xlsx-import"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Mykhailo Hladchenko",
            "email": "myhailo@hotmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^12.0|^13.0",
        "openspout/openspout": "^4.32",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Asignua\\FilamentXlsxImport\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Asignua\\FilamentXlsxImport\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Asignua\\FilamentXlsxImport\\XlsxImportServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
