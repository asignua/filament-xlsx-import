{
  "base": "http://host.docker.internal:8741",
  "login": {
    "path": "/admin/login",
    "email": "emma@example.com",
    "password": "password"
  },
  "shots": [
    {
      "path": "/admin/products",
      "out": "mapping.jpg",
      "theme": "light",
      "viewport": {
        "width": 1440,
        "height": 2000
      },
      "actions": [
        {
          "click": "button:has-text(\"Import\") >> nth=0"
        },
        {
          "waitFor": "input[type=file]"
        },
        {
          "upload": [
            "input[type=file]",
            "/plugins/filament-xlsx-import/build/samples/supplier-typed.xlsx"
          ]
        },
        {
          "waitFor": ".filepond--item[data-filepond-item-state=\"processing-complete\"]"
        },
        {
          "wait": 400
        },
        {
          "click": ".fi-modal-window button:has-text(\"Next\")"
        },
        {
          "waitFor": ".xi-source"
        },
        {
          "wait": 700
        },
        {
          "click": ".fi-fo-repeater-item:has(.xi-header:text-is(\"Ціна\")) [role=combobox]:has-text(\"Comma\")"
        },
        {
          "click": ".fi-select-input-option:visible >> text=Dot — 12.50"
        },
        {
          "wait": 900
        }
      ],
      "clip": {
        "x": 70,
        "y": 560,
        "width": 1300,
        "height": 1100
      }
    },
